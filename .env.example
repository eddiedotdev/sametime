# Copy to .env and chmod 600 .env. Never commit live tokens.
SLACK_APP_TOKEN=xapp-replace-with-connections-write-token
SLACK_USER_TOKEN=xoxp-replace-with-eddies-user-oauth-token
SLACK_TEAM_ID=T08JCP550E6
SLACK_USER_ID=U08J9KADTT7
# * alone enables all supported conversations in the configured workspace,
# for the authenticated sender only. An empty value is invalid.
# To restrict testing again, replace * with D08J9KAJ2VB and restart.
SLACK_CHANNEL_IDS=*
# Persistent opt-in for this authenticated sender's outgoing messages only.
AUTO_LOCALIZE=true
