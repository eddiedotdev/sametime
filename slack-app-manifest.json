{
  "display_information": {
    "name": "Time Zone Localizer POC",
    "description": "Local opt-in message time localization proof of concept"
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "chat:write",
        "users:read",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "user_events": [
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
